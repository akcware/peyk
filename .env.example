# --- identity (single user; schema carries user_id everywhere) ---
USER_ID=00000000-0000-4000-8000-000000000001
USER_PROFILE=                    # leave empty: Peyk asks the person and learns with their consent
USER_LANGUAGE=en

# --- database (docker compose exposes 5433 to avoid clashing with a local postgres) ---
DATABASE_URL=postgresql://agent:agent@localhost:5433/agent
NEON_DATABASE_URL=                 # production DB (docs/DEPLOY.md); the deploy script maps it to DATABASE_URL
TEST_DATABASE_URL=postgresql://agent:agent@localhost:5433/agent_test

# --- adapters loaded by the registry ---
ADAPTERS=composio,telegram

# --- telegram (direct Bot API) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- composio (gmail/calendar auth + triggers + actions) ---
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_USER_ID=default
COMPOSIO_GMAIL_AUTH_CONFIG_ID=      # ac_... from dashboard (Gmail toolkit auth config)
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=  # ca_... optional; filled by scripts/composio_setup.py
COMPOSIO_CALENDAR_AUTH_CONFIG_ID=    # phase 5; scripts/composio_setup.py --toolkit googlecalendar --create-auth-config
# document services (search/read in chat, create via approval): scripts/composio_setup.py --toolkit <slug> --create-auth-config
COMPOSIO_NOTION_AUTH_CONFIG_ID=
COMPOSIO_DRIVE_AUTH_CONFIG_ID=
COMPOSIO_DOCS_AUTH_CONFIG_ID=
# ws = composio.triggers.subscribe() websocket (local); webhook = events arrive at gateway
COMPOSIO_DELIVERY=ws
COMPOSIO_TOOLKIT_VERSIONS=gmail=20260911_00,googlecalendar=20260902_00,notion=20260911_00,googledrive=20260902_00,googledocs=20260826_00   # pinned; `scripts/composio_setup.py --toolkit gmail --status` shows current

# --- models (phase 1+) ---
MODEL_PROVIDER=bedrock            # bedrock | anthropic
AWS_REGION=us-east-1
# Voice notes: voxtral (Mistral Voxtral via Bedrock, no extra right) or transcribe (Amazon Transcribe streaming,
# same key + transcribe:StartStreamTranscription). Locales offered to language identification, max 5.
STT_ENGINE=voxtral
STT_MODEL_ID=mistral.voxtral-small-24b-2507
STT_LANGUAGES=en-US,de-DE,tr-TR,fr-FR,es-ES
VOICE_MAX_S=600
AWS_PROFILE=                      # local: a named profile with a long-lived IAM key; deploy: leave empty and set AWS_ACCESS_KEY_ID/SECRET
TRIAGE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0   # Bedrock cross-region inference profile
CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-6
ANTHROPIC_API_KEY=
AGENT_MODE=local                  # local | agentcore
AGENTCORE_RUNTIME_ARN=

# --- scheduler (phase 2) ---
TIMEZONE=Europe/Berlin
MORNING_BRIEF_AT=08:00
RECONCILE_EVERY=10m
RECONCILE_LOOKBACK_MINUTES=15

HEALTH_PORT=8080
LOG_LEVEL=INFO
